{
  "$defs": {
    "artifactLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "mediaType": {
          "$ref": "#/$defs/mediaType"
        },
        "path": {
          "$ref": "#/$defs/logicalArtifactPath"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "mediaType",
        "size",
        "digest"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "logicalArtifactPath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*\\u0000)(?!.*\\\\)(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*$",
      "type": "string"
    },
    "mediaType": {
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[ \\t]*[A-Za-z0-9!#$&^_.+-]+=(?:[A-Za-z0-9!#$&^_.+-]+|\\\"[^\\r\\n\\\"]*\\\"))*$",
      "type": "string"
    },
    "nonEmptyString": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "type": "string"
    },
    "sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://oac.dev/schemas/ctk/v0alpha2/CTKBundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural schema for the frozen Phase A CTK bundle manifest.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifactLedgerEntry"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "bundleDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "bundleFormatVersion": {
      "const": "oac.ctk.bundle/v0alpha2"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "profileId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profileVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "requirementSetRef": {
      "$ref": "#/$defs/logicalArtifactPath"
    },
    "resourceProfileRef": {
      "$ref": "#/$defs/logicalArtifactPath"
    },
    "standardVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "suiteId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "suiteVersion": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "required": [
    "bundleFormatVersion",
    "suiteId",
    "suiteVersion",
    "standardVersion",
    "profileId",
    "profileVersion",
    "requirementSetRef",
    "resourceProfileRef",
    "artifacts",
    "extensions",
    "bundleDigest"
  ],
  "title": "CTKBundle",
  "type": "object"
}
