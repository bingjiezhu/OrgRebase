{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oac.dev/schemas/ctk/v0alpha1/ConformanceCase.schema.json",
  "title": "ConformanceCase",
  "description": "Structural schema for the six frozen Phase A stdio-v1 conformance operations.",
  "$comment": "The frozen A0 runner validates every admitted case through the bundle-pinned copy of this schema after checking its external suite digest trust anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "operation",
    "input",
    "expect",
    "requirementRefs"
  ],
  "properties": {
    "caseId": {
      "$ref": "#/$defs/caseId"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "input": {
      "type": "object"
    },
    "expect": {
      "type": "object"
    },
    "requirementRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "canonicalize"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/canonicalizeInput"
          },
          "expect": {
            "$ref": "#/$defs/canonicalizeExpectation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "deriveIdentifier"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/deriveIdentifierInput"
          },
          "expect": {
            "$ref": "#/$defs/deriveIdentifierExpectation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "witness"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/witnessInput"
          },
          "expect": {
            "$ref": "#/$defs/witnessExpectation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "strongKleene"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/strongKleeneInput"
          },
          "expect": {
            "$ref": "#/$defs/strongKleeneExpectation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "closureMicro"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/closureMicroInput"
          },
          "expect": {
            "$ref": "#/$defs/closureMicroExpectation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "resourceCheck"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/resourceCheckInput"
          },
          "expect": {
            "$ref": "#/$defs/resourceCheckExpectation"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "base64": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Za-z][A-Za-z0-9_]*)?$"
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "triValue": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "admission": {
      "enum": [
        "admitted",
        "candidate",
        "disputed",
        "retracted"
      ]
    },
    "operation": {
      "enum": [
        "canonicalize",
        "deriveIdentifier",
        "witness",
        "strongKleene",
        "closureMicro",
        "resourceCheck"
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "additionalProperties": true
    },
    "completedExpectationBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sutStatus",
        "result"
      ],
      "properties": {
        "sutStatus": {
          "const": "COMPLETED"
        },
        "result": {
          "type": "object"
        },
        "domainVerdict": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "PROVISIONAL",
            "UNKNOWN"
          ]
        },
        "requiredReasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "forbiddenReasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        }
      }
    },
    "errorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sutStatus",
        "errorCode"
      ],
      "properties": {
        "sutStatus": {
          "enum": [
            "UNSUPPORTED",
            "RESOURCE_EXHAUSTED",
            "ERROR"
          ]
        },
        "errorCode": {
          "$ref": "#/$defs/reasonCode"
        }
      }
    },
    "canonicalizeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawBase64"
      ],
      "properties": {
        "rawBase64": {
          "$ref": "#/$defs/base64"
        }
      }
    },
    "canonicalizeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalBase64",
        "digest"
      ],
      "properties": {
        "canonicalBase64": {
          "$ref": "#/$defs/base64"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "canonicalizeExpectation": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/completedExpectationBase"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/canonicalizeResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/errorExpectation"
        }
      ]
    },
    "evaluationIdentifierFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "changeDigest",
        "changeSubjectRef",
        "sourceRef",
        "predicateVersion",
        "result",
        "reasonCodes",
        "witnessRefs"
      ],
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "changeDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "changeSubjectRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "predicateVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "$ref": "#/$defs/triValue"
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "witnessRefs": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "pathIdentifierFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "changeDigest",
        "targetRef",
        "state",
        "edgeRefs",
        "ruleRefs",
        "evaluationRefs",
        "dutyRefs",
        "origin",
        "truncated"
      ],
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "changeDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "targetRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "enum": [
            "affected",
            "unknown",
            "unaffected_proven",
            "out_of_declared_scope"
          ]
        },
        "edgeRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "ruleRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "evaluationRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "dutyRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "origin": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "obligationIdentifierFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "changeDigest",
        "origin",
        "targetRef",
        "requiredRoleRef",
        "obligationType",
        "resolutionState",
        "pathRefs"
      ],
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "changeDigest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "origin": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requiredRoleRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "obligationType": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resolutionState": {
          "enum": [
            "affected",
            "unknown"
          ]
        },
        "pathRefs": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "roleInstanceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleDefinitionRef",
        "principalRef",
        "obligationRefs"
      ],
      "properties": {
        "roleDefinitionRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "principalRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "obligationRefs": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "workUnitBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleInstanceRefs",
        "accountableRoleInstanceRef",
        "obligationRefs"
      ],
      "properties": {
        "roleInstanceRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "accountableRoleInstanceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "obligationRefs": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "planDecisionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectRef",
        "inputClass",
        "disposition",
        "reasonCodes"
      ],
      "properties": {
        "subjectRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputClass": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "disposition": {
          "enum": [
            "included",
            "excluded",
            "unresolved"
          ]
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        }
      }
    },
    "instanceIdentifierFieldsBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "changeDigest",
        "body"
      ],
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "changeDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "body": {
          "type": "object"
        }
      }
    },
    "deriveIdentifierInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "evaluation"
            },
            "fields": {
              "$ref": "#/$defs/evaluationIdentifierFields"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "path"
            },
            "fields": {
              "$ref": "#/$defs/pathIdentifierFields"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "obligation"
            },
            "fields": {
              "$ref": "#/$defs/obligationIdentifierFields"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "role-instance"
            },
            "fields": {
              "allOf": [
                {
                  "$ref": "#/$defs/instanceIdentifierFieldsBase"
                },
                {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/roleInstanceBody"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "work-unit"
            },
            "fields": {
              "allOf": [
                {
                  "$ref": "#/$defs/instanceIdentifierFieldsBase"
                },
                {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/workUnitBody"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierKind",
            "fields"
          ],
          "properties": {
            "identifierKind": {
              "const": "plan-decision"
            },
            "fields": {
              "allOf": [
                {
                  "$ref": "#/$defs/instanceIdentifierFieldsBase"
                },
                {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/planDecisionBody"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "deriveIdentifierResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^urn:oac:(?:mvp:(?:evaluation|path|obligation):[0-9a-f]{24}|id:sha256:v1:(?:role-instance|work-unit|plan-decision):[0-9a-f]{64})$"
        }
      }
    },
    "deriveIdentifierExpectation": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/completedExpectationBase"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/deriveIdentifierResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/errorExpectation"
        }
      ]
    },
    "witnessInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "resourceId",
            "pointer"
          ],
          "properties": {
            "mode": {
              "const": "encode"
            },
            "resourceId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "pointer": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:|/.*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "witnessRef"
          ],
          "properties": {
            "mode": {
              "const": "decode"
            },
            "witnessRef": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "witnessResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "witnessRef"
          ],
          "properties": {
            "witnessRef": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "pointer"
          ],
          "properties": {
            "resourceId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "pointer": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:|/.*)$"
            }
          }
        }
      ]
    },
    "witnessExpectation": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/completedExpectationBase"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/witnessResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/errorExpectation"
        }
      ]
    },
    "strongKleeneInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "values"
      ],
      "properties": {
        "operator": {
          "enum": [
            "all",
            "any"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/triValue"
          }
        }
      }
    },
    "strongKleeneResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/triValue"
        }
      }
    },
    "strongKleeneExpectation": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/completedExpectationBase"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/strongKleeneResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/errorExpectation"
        }
      ]
    },
    "closureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "admission"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      }
    },
    "closureEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "result",
        "admission",
        "covered"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "$ref": "#/$defs/triValue"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        },
        "covered": {
          "type": "boolean"
        }
      }
    },
    "closureMicroInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "maxDepth",
        "maxPathPrefixes",
        "nodes",
        "edges"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxPathPrefixes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/closureNode"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/closureEdge"
          }
        }
      }
    },
    "closurePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeRefs",
        "reasonCodes",
        "state",
        "targetRef",
        "truncated"
      ],
      "properties": {
        "edgeRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "state": {
          "enum": [
            "affected",
            "unknown"
          ]
        },
        "targetRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "falseFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative",
        "edgeId",
        "edgeRefs",
        "sourceRef",
        "targetRef"
      ],
      "properties": {
        "authoritative": {
          "type": "boolean"
        },
        "edgeId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "edgeRefs": {
          "$ref": "#/$defs/stringSet"
        },
        "sourceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "closureMicroResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rootRef",
        "paths",
        "falseFrontiers",
        "unresolvedRefs"
      ],
      "properties": {
        "kind": {
          "const": "ClosureMicroReport"
        },
        "rootRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/closurePath"
          }
