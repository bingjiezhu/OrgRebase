{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oac.dev/ctk/schemas/PlanVerificationCapabilitySet.schema.json",
  "title": "OAC Plan-verification ProtocolCapabilitySet v0alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capabilitySetId", "protocolVersion", "tracks", "digestAlgorithm", "capabilitySetDigest"],
  "properties": {
    "apiVersion": {"const": "oac.ctk.capability-set/v0alpha2"},
    "kind": {"const": "ProtocolCapabilitySet"},
    "capabilitySetId": {"const": "oac.supplier.plan-verification.plural-capsule/v0.1-seed-1"},
    "protocolVersion": {"const": "oac.ctk.stdio/v3"},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "operation", "profileId", "profileVersion", "wireVersion"],
        "properties": {
          "role": {"const": "plan-verifier"},
          "operation": {"const": "verifyPlan"},
          "profileId": {"const": "oac.supplier.plan-verification.plural-capsule"},
          "profileVersion": {"const": "v0.1-seed-1"},
          "wireVersion": {"const": "oac.ctk.stdio/v3"}
        }
      }
    },
    "digestAlgorithm": {"const": "sha256-jcs-detached/v1"},
    "capabilitySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
