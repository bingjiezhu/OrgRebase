{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oac.dev/schemas/ctk/v0.2/ProfileSemanticRuleSet.schema.json",
  "title": "ProfileSemanticRuleSet",
  "description": "Digest-bound, implementation-neutral semantic decisions for one OAC Profile version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "ruleSetId",
    "profileId",
    "profileVersion",
    "rules",
    "digest"
  ],
  "properties": {
    "apiVersion": {
      "const": "oac.profile.semantic-rules/v0alpha1"
    },
    "kind": {
      "const": "ProfileSemanticRuleSet"
    },
    "ruleSetId": {
      "$ref": "#/$defs/nonBlank"
    },
    "profileId": {
      "$ref": "#/$defs/nonBlank"
    },
    "profileVersion": {
      "$ref": "#/$defs/nonBlank"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "scope",
        "statement",
        "normativeRef",
        "reasonCodes",
        "testClasses"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^OAC-SUP-SEM-[0-9]{3}$"
        },
        "ruleVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "scope": {
          "enum": [
            "root_authority",
            "applicability_ledger",
            "reason_projection",
            "impact_closure",
            "bounded_non_impact",
            "residual_projection",
            "discovery_obligation",
            "boundary_identity",
            "unresolved_projection",
            "error_precedence"
          ]
        },
        "statement": {
          "$ref": "#/$defs/nonBlank"
        },
        "normativeRef": {
          "$ref": "#/$defs/nonBlank"
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        },
        "testClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        }
      }
    }
  }
}
