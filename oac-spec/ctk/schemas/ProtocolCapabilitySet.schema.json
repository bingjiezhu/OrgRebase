{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oac.dev/schemas/ctk/v0alpha1/ProtocolCapabilitySet.schema.json",
  "title": "ProtocolCapabilitySet",
  "description": "A content-bound exact protocol track set for one bounded conformance coordinate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "capabilitySetId",
    "protocolVersion",
    "reportCoordinate",
    "tracks",
    "digestAlgorithm",
    "capabilitySetDigest"
  ],
  "properties": {
    "apiVersion": {"const": "oac.ctk.capability-set/v0alpha1"},
    "kind": {"const": "ProtocolCapabilitySet"},
    "capabilitySetId": {"$ref": "#/$defs/nonBlankString"},
    "protocolVersion": {"const": "oac.ctk.stdio/v2"},
    "reportCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion"],
      "properties": {
        "profileId": {"const": "oac.supplier.transfer"},
        "profileVersion": {"const": "v0.2"}
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/track"}
    },
    "digestAlgorithm": {"const": "sha256-jcs-detached/v1"},
    "capabilitySetDigest": {"$ref": "#/$defs/sha256Digest"}
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "operation", "profileId", "profileVersion", "wireVersion"],
      "properties": {
        "role": {"const": "semantic-kernel"},
        "operation": {"enum": ["validateResource", "derive"]},
        "profileId": {"$ref": "#/$defs/nonBlankString"},
        "profileVersion": {"$ref": "#/$defs/nonBlankString"},
        "wireVersion": {"const": "oac.ctk.stdio/v2"}
      }
    }
  }
}
