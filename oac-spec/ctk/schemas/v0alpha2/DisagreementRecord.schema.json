{
  "$defs": {
    "caseId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "digestMap": {
      "additionalProperties": {
        "$ref": "#/$defs/sha256Digest"
      },
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "generatedCase": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "generatorDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "generatorId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "generatorVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "minimizedReproducerDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "minimizerVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "originalInputDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "seed": {
          "oneOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/nonEmptyString"
            }
          ]
        }
      },
      "required": [
        "generatorId",
        "generatorVersion",
        "generatorDigest",
        "seed",
        "originalInputDigest",
        "minimizedReproducerDigest",
        "minimizerVersion"
      ],
      "type": "object"
    },
    "nonEmptyString": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "type": "string"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "artifactDigests": {
          "$ref": "#/$defs/digestMap"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "implementationBuildDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "implementationId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observationDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "required": [
        "implementationId",
        "implementationBuildDigest",
        "artifactDigests",
        "observationDigest"
      ],
      "type": "object"
    },
    "sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://oac.dev/schemas/ctk/v0alpha2/DisagreementRecord.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "OPEN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "regressionCaseRef": {
            "type": "null"
          },
          "resolutionRef": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESOLVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "regressionCaseRef": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "resolutionRef": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  ],
  "description": "Closed governance record for preserving a conformance disagreement without majority or reference-wins semantics.",
  "properties": {
    "affectedVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "apiVersion": {
      "const": "oac.ctk.disagreement/v0.2"
    },
    "bundleDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "caseId": {
      "$ref": "#/$defs/caseId"
    },
    "classification": {
      "enum": [
        "IMPLEMENTATION_DEFECT",
        "SPECIFICATION_DEFECT",
        "FIXTURE_DEFECT",
        "HARNESS_DEFECT",
        "CONTESTED_SEMANTICS",
        "UNCLASSIFIED"
      ]
    },
    "digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "disagreementId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "generatedCase": {
      "$ref": "#/$defs/generatedCase"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "owner": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "regressionCaseRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolutionRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "ADAPTER",
        "HARNESS",
        "PARSE",
        "SCHEMA",
        "CANONICAL_BYTES",
        "DERIVATION",
        "VERDICT",
        "REASON_SET",
        "WITNESS_BINDING",
        "RESOURCE_EXHAUSTION"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED"
      ]
    }
  },
  "required": [
    "apiVersion",
    "disagreementId",
    "caseId",
    "bundleDigest",
    "stage",
    "observations",
    "classification",
    "status",
    "owner",
    "affectedVersion",
    "resolutionRef",
    "regressionCaseRef",
    "digest"
  ],
  "title": "DisagreementRecord",
  "type": "object"
}
