{
  "$defs": {
    "ChangeProfileBinding": {
      "additionalProperties": false,
      "properties": {
        "profileDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profiledigest",
          "type": "string"
        },
        "profileId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Profileid",
          "type": "string"
        },
        "profileVersion": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Profileversion",
          "type": "string"
        }
      },
      "required": [
        "profileId",
        "profileVersion",
        "profileDigest"
      ],
      "title": "ChangeProfileBinding",
      "type": "object"
    },
    "DimensionVerdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "DimensionVerdict",
      "type": "string"
    },
    "PlanCertificateSpec": {
      "additionalProperties": false,
      "properties": {
        "certifierBuild": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Certifierbuild",
          "type": "string"
        },
        "certifierId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Certifierid",
          "type": "string"
        },
        "changeRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/VerificationDimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "profileBinding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeProfileBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasonCodes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
            "type": "string"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "restrictions": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "snapshotRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "subjectPlanRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "unresolvedRefs": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolvedrefs",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "subjectPlanRef",
        "snapshotRef",
        "changeRef",
        "verdict",
        "dimensions",
        "reasonCodes",
        "restrictions",
        "unresolvedRefs",
        "certifierId",
        "certifierBuild"
      ],
      "title": "PlanCertificateSpec",
      "type": "object"
    },
    "ResourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectivefrom"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectiveto"
        },
        "governanceRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governanceref"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "ownerRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerref"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "namespace",
        "revision",
        "createdAt"
      ],
      "title": "ResourceMetadata",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "oac.dev/v0alpha1",
          "default": "oac.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resourceId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resourceid",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "namespace",
        "resourceId",
        "revision",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "PROVISIONAL",
        "UNKNOWN"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "VerificationDimension": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reasonCodes": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
            "type": "string"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/DimensionVerdict"
        },
        "witnesses": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Witnesses",
          "type": "array"
        },
        "witnessesOmitted": {
          "default": 0,
          "minimum": 0,
          "title": "Witnessesomitted",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "verdict"
      ],
      "title": "VerificationDimension",
      "type": "object"
    }
  },
  "$id": "https://oac.dev/schemas/v0alpha1/PlanCertificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "oac.dev/v0alpha1",
      "default": "oac.dev/v0alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "kind": {
      "const": "PlanCertificate",
      "default": "PlanCertificate",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/PlanCertificateSpec"
    }
  },
  "required": [
    "metadata",
    "spec"
  ],
  "title": "PlanCertificate",
  "type": "object"
}
