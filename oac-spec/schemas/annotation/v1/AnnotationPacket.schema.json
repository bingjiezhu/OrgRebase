{
  "$defs": {
    "AnnotationPacketSpec": {
      "additionalProperties": false,
      "properties": {
        "allowedEvidence": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Allowedevidence",
          "type": "array"
        },
        "authorityRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "caseRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "changeRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "observationBoundary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Observationboundary",
          "type": "string"
        },
        "snapshotRef": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "authorityRef",
        "caseRef",
        "snapshotRef",
        "changeRef",
        "observationBoundary",
        "allowedEvidence"
      ],
      "title": "AnnotationPacketSpec",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        },
        "resourceRef": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "resourceRef",
        "pointer"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "ResourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectivefrom"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectiveto"
        },
        "governanceRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governanceref"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "ownerRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerref"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "namespace",
        "revision",
        "createdAt"
      ],
      "title": "ResourceMetadata",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "oac.dev/v0alpha1",
          "default": "oac.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resourceId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resourceid",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "namespace",
        "resourceId",
        "revision",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "$id": "https://oac.dev/schemas/annotation/v1/AnnotationPacket.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "oac.annotation-document/v1",
      "default": "oac.annotation-document/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "kind": {
      "const": "AnnotationPacket",
      "maxLength": 512,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/AnnotationPacketSpec"
    }
  },
  "required": [
    "kind",
    "metadata",
    "spec",
    "digest"
  ],
  "title": "AnnotationDocument[AnnotationPacketSpec]",
  "type": "object"
}
