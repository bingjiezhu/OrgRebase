{
  "$defs": {
    "AnnotationRound": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        },
        "resourceRef": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "resourceRef",
        "pointer"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ResourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectivefrom"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectiveto"
        },
        "governanceRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governanceref"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "ownerRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerref"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "namespace",
        "revision",
        "createdAt"
      ],
      "title": "ResourceMetadata",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "oac.dev/v0alpha1",
          "default": "oac.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resourceId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resourceid",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "namespace",
        "resourceId",
        "revision",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ReviewAttestationSpec": {
      "additionalProperties": false,
      "properties": {
        "deliveryRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ReviewField"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "modelAssistance": {
          "title": "Modelassistance",
          "type": "boolean"
        },
        "packetRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "reviewerKey": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reviewerkey",
          "type": "string"
        },
        "round": {
          "$ref": "#/$defs/AnnotationRound"
        }
      },
      "required": [
        "packetRef",
        "deliveryRef",
        "reviewerKey",
        "round",
        "fields",
        "modelAssistance"
      ],
      "title": "ReviewAttestationSpec",
      "type": "object"
    },
    "ReviewField": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "title": "Evidence",
          "type": "array"
        },
        "field": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "rationale": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unknown",
            "contested"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "value",
        "status",
        "evidence",
        "rationale"
      ],
      "title": "ReviewField",
      "type": "object"
    }
  },
  "$id": "https://oac.dev/schemas/annotation/v1/ReviewAttestation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "oac.annotation-document/v1",
      "default": "oac.annotation-document/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "kind": {
      "const": "ReviewAttestation",
      "maxLength": 512,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ResourceMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ReviewAttestationSpec"
    }
  },
  "required": [
    "kind",
    "metadata",
    "spec",
    "digest"
  ],
  "title": "AnnotationDocument[ReviewAttestationSpec]",
  "type": "object"
}
