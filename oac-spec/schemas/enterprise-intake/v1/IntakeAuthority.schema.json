{
  "$defs": {
    "AdmissionVerdict": {
      "enum": [
        "ADMITTED",
        "REJECTED",
        "UNKNOWN"
      ],
      "title": "AdmissionVerdict",
      "type": "string"
    },
    "IntakeActor": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "PROPOSE",
              "REVIEW",
              "ADMIT"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "actorType": {
          "enum": [
            "HUMAN",
            "AI",
            "AI_CONTROLLED"
          ],
          "title": "Actortype",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "ref",
        "actorType",
        "actions"
      ],
      "title": "IntakeActor",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ResourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectivefrom"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effectiveto"
        },
        "governanceRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governanceref"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "ownerRef": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerref"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "namespace",
        "revision",
        "createdAt"
      ],
      "title": "ResourceMetadata",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "oac.dev/v0alpha1",
          "default": "oac.dev/v0alpha1",
          "title": "Apiversion",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resourceId": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resourceid",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "namespace",
        "resourceId",
        "revision",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "$id": "https://oac.dev/schemas/enterprise-intake/v1/IntakeAuthority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "oac.enterprise-intake.document/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "kind": {
      "const": "IntakeAuthority",
      "maxLength": 512,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ResourceMetadata"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/IntakeActor"
          },
          "minItems": 1,
          "title": "Actors",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/AdmissionVerdict"
        },
        "decisionAuthorityRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "evidenceClass": {
          "enum": [
            "SCRIPTED_LOCAL",
            "EXTERNAL_ASSERTION"
          ],
          "title": "Evidenceclass",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "manifestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifestdigest",
          "type": "string"
        },
        "profileRef": {
          "$ref": "#/$defs/ResourceRef"
        },
        "reasonCodes": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "reviewerRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "minItems": 1,
          "title": "Reviewerrefs",
          "type": "array"
        },
        "scopeRefs": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Scoperefs",
          "type": "array"
        },
        "subjectRefs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "minItems": 1,
          "title": "Subjectrefs",
          "type": "array"
        }
      },
      "required": [
        "profileRef",
        "manifestDigest",
        "subjectRefs",
        "actors",
        "decisionAuthorityRef",
        "reviewerRefs",
        "decision",
        "issuedAt",
        "expiresAt",
        "scopeRefs",
        "evidenceClass"
      ],
      "title": "IntakeAuthoritySpec",
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "digest"
  ],
  "title": "IntakeAuthority",
  "type": "object"
}
