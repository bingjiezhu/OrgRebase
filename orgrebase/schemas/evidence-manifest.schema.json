{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/evidence-manifest.schema.json",
  "title": "OrgRebase Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow_run_id", "run_nonce", "digest_algorithm",
    "artifacts", "capabilities", "verifier", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.evidence-manifest.v2"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest_algorithm": {"const": "orgrebase-canonical-json-sha256-v1"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "status", "evidence_class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"const": "IMPLEMENTED"},
          "evidence_class": {
            "enum": ["LOCAL_DETERMINISTIC", "LOCAL_REAL_TOOL", "SYNTHETIC_FIXTURE"]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence_class", "artifact"],
        "properties": {
          "status": {"enum": ["IMPLEMENTED", "DESIGNED", "STATIC_ONLY", "REPLAY_ONLY", "NOT_RUN"]},
          "evidence_class": {"enum": ["LOCAL_DETERMINISTIC", "LOCAL_REAL_TOOL", "SYNTHETIC_FIXTURE", "PASS_STATIC", "NOT_RUN"]},
          "artifact": {"type": ["string", "null"]}
        }
      }
    },
    "verifier": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
