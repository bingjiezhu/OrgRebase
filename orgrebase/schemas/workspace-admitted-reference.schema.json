{
  "$defs": {
    "ClaimScope": {
      "enum": [
        "ORGANIZATION",
        "TASK"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "DependencyStrength": {
      "enum": [
        "HARD",
        "REVIEW",
        "INFORMATIONAL"
      ],
      "title": "DependencyStrength",
      "type": "string"
    },
    "JsonValue": {},
    "SemanticKind": {
      "enum": [
        "CLAIM",
        "POLICY",
        "SKILL",
        "TOOL",
        "LITERAL"
      ],
      "title": "SemanticKind",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-admitted-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_decision_ref": {
      "title": "Admission Decision Ref",
      "type": "string"
    },
    "claim_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "object_digest": {
      "title": "Object Digest",
      "type": "string"
    },
    "object_ref": {
      "title": "Object Ref",
      "type": "string"
    },
    "projection": {
      "$ref": "#/$defs/JsonValue"
    },
    "projection_digest": {
      "title": "Projection Digest",
      "type": "string"
    },
    "projection_schema_ref": {
      "title": "Projection Schema Ref",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "recipient_ids": {
      "items": {
        "type": "string"
      },
      "title": "Recipient Ids",
      "type": "array"
    },
    "relation": {
      "title": "Relation",
      "type": "string"
    },
    "semantic_kind": {
      "$ref": "#/$defs/SemanticKind"
    },
    "slot_id": {
      "title": "Slot Id",
      "type": "string"
    },
    "strength": {
      "$ref": "#/$defs/DependencyStrength"
    }
  },
  "required": [
    "slot_id",
    "object_ref",
    "object_digest",
    "projection_schema_ref",
    "projection",
    "projection_digest",
    "relation",
    "strength",
    "semantic_kind",
    "claim_scope",
    "purpose",
    "recipient_ids",
    "expires_at",
    "admission_decision_ref"
  ],
  "title": "AdmittedReference",
  "type": "object"
}
