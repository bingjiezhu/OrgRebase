{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/workspace-agentteams-control-decision.schema.json",
  "title": "OrgRebase AgentTeams controlled-local control decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "nonce", "project_id", "task_id", "domain",
    "attempt", "expected_binding_digest", "observed_binding_digest",
    "active_attempt_ref", "active_fencing_token", "observed_result_digest",
    "verdict", "reason_codes", "candidate_only", "target_writes",
    "decision_digest"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.workspace-agentteams-control-decision.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["product", "legal", "finance", "gtm"]},
    "attempt": {"type": "integer", "minimum": 1},
    "expected_binding_digest": {"$ref": "#/$defs/digest"},
    "observed_binding_digest": {"$ref": "#/$defs/digest"},
    "active_attempt_ref": {"$ref": "#/$defs/digest"},
    "active_fencing_token": {"$ref": "#/$defs/digest"},
    "observed_result_digest": {"$ref": "#/$defs/digest"},
    "verdict": {"enum": ["ADMIT", "REJECT"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_only": {"const": true},
    "target_writes": {"const": 0},
    "decision_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
