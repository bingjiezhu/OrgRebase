{
  "$defs": {
    "AlertRecord": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "orgrebase.telemetry-alert.v1",
          "default": "orgrebase.telemetry-alert.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "WARNING",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "rule_id",
        "severity",
        "reason_code"
      ],
      "title": "AlertRecord",
      "type": "object"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-alert-evaluation-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/AlertRecord"
      },
      "title": "Alerts",
      "type": "array"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "evidence_class": {
      "const": "OBSERVED_CONTROLLED_LOCAL",
      "default": "OBSERVED_CONTROLLED_LOCAL",
      "title": "Evidence Class",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_digest": {
      "title": "Input Digest",
      "type": "string"
    },
    "observed_layers": {
      "items": {
        "type": "string"
      },
      "title": "Observed Layers",
      "type": "array"
    },
    "required_layers": {
      "items": {
        "type": "string"
      },
      "title": "Required Layers",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orgrebase.alert-evaluation-receipt.v1",
      "default": "orgrebase.alert-evaluation-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "ALERT"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "required_layers",
    "observed_layers",
    "alerts",
    "input_digest",
    "status"
  ],
  "title": "AlertEvaluationReceipt",
  "type": "object"
}
