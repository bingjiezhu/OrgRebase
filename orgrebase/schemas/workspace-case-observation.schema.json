{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://orgrebase.local/schemas/workspace-case-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "certificate": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Certificate",
      "type": "object"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "SUPPORT",
        "COUNTEREXAMPLE",
        "NULL",
        "UNKNOWN"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "public_input": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Public Input",
      "type": "object"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "revision",
    "public_input",
    "outcome",
    "certificate"
