{
  "$id": "https://orgrebase.local/schemas/workspace-coordination-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "event_digest",
    "reason"
  ],
  "title": "CoordinationInput",
  "type": "object"
}
