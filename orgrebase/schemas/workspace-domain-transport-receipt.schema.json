{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "CONTROLLED_LOCAL_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-domain-transport-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digests": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Digests",
      "type": "array"
    },
    "coalition_plan_ref": {
      "title": "Coalition Plan Ref",
      "type": "string"
    },
    "delegation_task_digests": {
      "items": {
        "type": "string"
      },
      "title": "Delegation Task Digests",
      "type": "array"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nonce": {
      "title": "Nonce",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "selected_worker_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Worker Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "PASS",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_writes": {
      "const": 0,
      "default": 0,
      "title": "Target Writes",
      "type": "integer"
    },
    "task_ref": {
      "title": "Task Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task_ref",
    "coalition_plan_ref",
    "delegation_task_digests",
    "candidate_digests",
    "selected_worker_ids",
    "run_id",
    "nonce",
    "status",
    "evidence_class"
  ],
  "title": "DomainTransportReceipt",
  "type": "object"
}
