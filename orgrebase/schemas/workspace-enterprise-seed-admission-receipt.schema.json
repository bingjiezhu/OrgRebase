{
  "$defs": {
    "AdmissionDimension": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "PARSE",
            "SOURCE_BYTES",
            "SEED_READY",
            "SHADOW_INTAKE_ADMISSIBLE",
            "REFERENCE_RUNTIME"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AdmissionDimensionStatus"
        }
      },
      "required": [
        "name",
        "status",
        "reason_codes"
      ],
      "title": "AdmissionDimension",
      "type": "object"
    },
    "AdmissionDimensionStatus": {
      "enum": [
        "PASS",
        "HOLD",
        "REJECT"
      ],
      "title": "AdmissionDimensionStatus",
      "type": "string"
    },
    "AdmittedClaimCeiling": {
      "enum": [
        "INTAKE_VALIDATED",
        "REFERENCE_PROFILE_INTAKE"
      ],
      "title": "AdmittedClaimCeiling",
      "type": "string"
    },
    "AdmittedGapAction": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "effective_blocks": {
          "items": {
            "$ref": "#/$defs/ReadinessGate"
          },
          "title": "Effective Blocks",
          "type": "array"
        },
        "gap_digest": {
          "title": "Gap Digest",
          "type": "string"
        },
        "gap_ref": {
          "minLength": 1,
          "title": "Gap Ref",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SeedGapKind"
        },
        "minimum_blocks": {
          "items": {
            "$ref": "#/$defs/ReadinessGate"
          },
          "title": "Minimum Blocks",
          "type": "array"
        },
        "owner_ref": {
          "minLength": 1,
          "title": "Owner Ref",
          "type": "string"
        },
        "resolution_gate_ref": {
          "minLength": 1,
          "title": "Resolution Gate Ref",
          "type": "string"
        }
      },
      "required": [
        "gap_ref",
        "gap_digest",
        "kind",
        "component",
        "owner_ref",
        "effective_blocks",
        "minimum_blocks",
        "resolution_gate_ref"
      ],
      "title": "AdmittedGapAction",
      "type": "object"
    },
    "GrowthLevel": {
      "enum": [
        "G0_DESCRIBE",
        "G1_SELECT",
        "G2_BOUNDED_COMPOSE"
      ],
      "title": "GrowthLevel",
      "type": "string"
    },
    "ProfileLimitationCode": {
      "enum": [
        "SYNTHETIC_DATA_ONLY",
        "NO_EXTERNAL_CONNECTORS",
        "NO_OUTCOME_ASSURANCE",
        "INTAKE_ONLY",
        "PARTIAL_COVERAGE",
        "OPEN_GAPS_RETAINED",
        "NO_EXTERNAL_ENTERPRISE_VALIDATION"
      ],
      "title": "ProfileLimitationCode",
      "type": "string"
    },
    "ReadinessGate": {
      "enum": [
        "SEED_READY",
        "SHADOW_READY",
        "REFERENCE_RUNTIME",
        "OUTCOME_ASSURANCE"
      ],
      "title": "ReadinessGate",
      "type": "string"
    },
    "SeedComponentKind": {
      "enum": [
        "DOMAIN",
        "KNOWLEDGE",
        "AUTHORITY",
        "CAPABILITY",
        "DEPENDENCY"
      ],
      "title": "SeedComponentKind",
      "type": "string"
    },
    "SeedGapKind": {
      "enum": [
        "MISSING_SOURCE",
        "INCOMPLETE_COVERAGE",
        "UNKNOWN_AUTHORITY",
        "UNVERIFIED_DEPENDENCY",
        "MISSING_OUTCOME_BASELINE"
      ],
      "title": "SeedGapKind",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-enterprise-seed-admission-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admitted_claim_ceiling": {
      "$ref": "#/$defs/AdmittedClaimCeiling"
    },
    "admitted_source_root_digests": {
      "items": {
        "type": "string"
      },
      "title": "Admitted Source Root Digests",
      "type": "array"
    },
    "canonical_target_writes": {
      "const": 0,
      "default": 0,
      "title": "Canonical Target Writes",
      "type": "integer"
    },
    "component_admission_digests": {
      "items": {
        "type": "string"
      },
      "title": "Component Admission Digests",
      "type": "array"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/AdmissionDimension"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "gap_actions": {
      "items": {
        "$ref": "#/$defs/AdmittedGapAction"
      },
      "title": "Gap Actions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/ProfileLimitationCode"
      },
      "title": "Limitations",
      "type": "array"
    },
    "parsed": {
      "const": true,
      "default": true,
      "title": "Parsed",
      "type": "boolean"
    },
    "profile_digest": {
      "title": "Profile Digest",
      "type": "string"
    },
    "profile_ref": {
      "title": "Profile Ref",
      "type": "string"
    },
    "reference_runtime_compatible": {
      "title": "Reference Runtime Compatible",
      "type": "boolean"
    },
    "schema_version": {
      "const": "orgrebase.enterprise-seed-admission-receipt.v1",
      "default": "orgrebase.enterprise-seed-admission-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_ready": {
      "title": "Seed Ready",
      "type": "boolean"
    },
    "shadow_intake_admissible": {
      "title": "Shadow Intake Admissible",
      "type": "boolean"
    },
    "source_admission_receipt_digest": {
      "title": "Source Admission Receipt Digest",
      "type": "string"
    },
    "source_profile_projection_digest": {
      "title": "Source Profile Projection Digest",
      "type": "string"
    },
    "verified_growth_level": {
      "$ref": "#/$defs/GrowthLevel"
    }
  },
  "required": [
    "profile_ref",
    "profile_digest",
    "source_admission_receipt_digest",
    "admitted_source_root_digests",
    "component_admission_digests",
    "source_profile_projection_digest",
    "seed_ready",
    "shadow_intake_admissible",
    "reference_runtime_compatible",
    "dimensions",
    "gap_actions",
    "admitted_claim_ceiling",
    "verified_growth_level",
    "limitations"
  ],
  "title": "EnterpriseSeedAdmissionReceipt",
  "type": "object"
}
