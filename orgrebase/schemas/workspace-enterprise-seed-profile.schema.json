{
  "$defs": {
    "ChangeFamilyBinding": {
      "additionalProperties": false,
      "properties": {
        "base_version": {
          "minLength": 1,
          "title": "Base Version",
          "type": "string"
        },
        "change_id": {
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "owner_id": {
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "proposed_version": {
          "minLength": 1,
          "title": "Proposed Version",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "owner_id",
        "change_id",
        "revision",
        "purpose",
        "object_id",
        "base_version",
        "proposed_version",
        "idempotency_key"
      ],
      "title": "ChangeFamilyBinding",
      "type": "object"
    },
    "DefaultTaskBinding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        },
        "deliverable_kind": {
          "minLength": 1,
          "title": "Deliverable Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "input_values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SeedInputValue"
          },
          "title": "Input Values",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "requested_at": {
          "minLength": 1,
          "title": "Requested At",
          "type": "string"
        },
        "template_ref": {
          "minLength": 1,
          "title": "Template Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "actor_id",
        "purpose",
        "deliverable_kind",
        "requested_at",
        "template_ref",
        "idempotency_key"
      ],
      "title": "DefaultTaskBinding",
      "type": "object"
    },
    "EffectCeiling": {
      "enum": [
        "ZERO_EXTERNAL_EFFECTS",
        "EXTERNAL_EFFECTS"
      ],
      "title": "EffectCeiling",
      "type": "string"
    },
    "EnterpriseSeedGap": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/ReadinessGate"
          },
          "title": "Blocks",
          "type": "array"
        },
        "component": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SeedGapKind"
        },
        "owner_ref": {
          "minLength": 1,
          "title": "Owner Ref",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "resolution_gate_ref": {
          "minLength": 1,
          "title": "Resolution Gate Ref",
          "type": "string"
        },
        "status": {
          "const": "OPEN",
          "default": "OPEN",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "component",
        "path",
        "description",
        "owner_ref",
        "resolution_gate_ref",
        "blocks"
      ],
      "title": "EnterpriseSeedGap",
      "type": "object"
    },
    "GovernanceBinding": {
      "additionalProperties": false,
      "properties": {
        "admission_authority_refs": {
          "items": {
            "type": "string"
          },
          "title": "Admission Authority Refs",
          "type": "array"
        },
        "owner_refs": {
          "items": {
            "type": "string"
          },
          "title": "Owner Refs",
          "type": "array"
        },
        "rejection_path_ref": {
          "minLength": 1,
          "title": "Rejection Path Ref",
          "type": "string"
        },
        "unknown_path_ref": {
          "minLength": 1,
          "title": "Unknown Path Ref",
          "type": "string"
        }
      },
      "required": [
        "admission_authority_refs",
        "owner_refs",
        "rejection_path_ref",
        "unknown_path_ref"
      ],
      "title": "GovernanceBinding",
      "type": "object"
    },
    "GrowthLevel": {
      "enum": [
        "G0_DESCRIBE",
        "G1_SELECT",
        "G2_BOUNDED_COMPOSE"
      ],
      "title": "GrowthLevel",
      "type": "string"
    },
    "ProfileLimitationCode": {
      "enum": [
        "SYNTHETIC_DATA_ONLY",
        "NO_EXTERNAL_CONNECTORS",
        "NO_OUTCOME_ASSURANCE",
        "INTAKE_ONLY",
        "PARTIAL_COVERAGE",
        "OPEN_GAPS_RETAINED",
        "NO_EXTERNAL_ENTERPRISE_VALIDATION"
      ],
      "title": "ProfileLimitationCode",
      "type": "string"
    },
    "ReadinessGate": {
      "enum": [
        "SEED_READY",
        "SHADOW_READY",
        "REFERENCE_RUNTIME",
        "OUTCOME_ASSURANCE"
      ],
      "title": "ReadinessGate",
      "type": "string"
    },
    "RuntimeCompatibilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "handler_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handler Profile"
        },
        "mode": {
          "$ref": "#/$defs/RuntimeCompatibilityMode"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RuntimeCompatibilityDeclaration",
      "type": "object"
    },
    "RuntimeCompatibilityMode": {
      "enum": [
        "REFERENCE_HANDLER",
        "INTAKE_ONLY"
      ],
      "title": "RuntimeCompatibilityMode",
      "type": "string"
    },
    "SeedCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "SeedCompleteness",
      "type": "string"
    },
    "SeedComponent": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/$defs/SeedCompleteness"
        },
        "declared_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Digest"
        },
        "kind": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "source_root_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Root Refs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "completeness",
        "source_root_refs"
      ],
      "title": "SeedComponent",
      "type": "object"
    },
    "SeedComponentKind": {
      "enum": [
        "DOMAIN",
        "KNOWLEDGE",
        "AUTHORITY",
        "CAPABILITY",
        "DEPENDENCY"
      ],
      "title": "SeedComponentKind",
      "type": "string"
    },
    "SeedDataClass": {
      "enum": [
        "SYNTHETIC_FIXTURE",
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL"
      ],
      "title": "SeedDataClass",
      "type": "string"
    },
    "SeedGapKind": {
      "enum": [
        "MISSING_SOURCE",
        "INCOMPLETE_COVERAGE",
        "UNKNOWN_AUTHORITY",
        "UNVERIFIED_DEPENDENCY",
        "MISSING_OUTCOME_BASELINE"
      ],
      "title": "SeedGapKind",
      "type": "string"
    },
    "SeedInputValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "SeedInputValue",
      "type": "object"
    },
    "SeedSourceRoot": {
      "additionalProperties": false,
      "properties": {
        "declared_digest": {
          "title": "Declared Digest",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "media_type",
        "locator",
        "declared_digest"
      ],
      "title": "SeedSourceRoot",
      "type": "object"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-enterprise-seed-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned, content-addressed enterprise intake package.\n\nAll collections are tuples of frozen models; callers cannot mutate a nested\nmapping after the profile digest has been computed.",
  "properties": {
    "change_family": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChangeFamilyBinding"
      },
      "title": "Change Family",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/SeedComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "data_class": {
      "$ref": "#/$defs/SeedDataClass"
    },
    "declared_limitation_codes": {
      "items": {
        "$ref": "#/$defs/ProfileLimitationCode"
      },
      "title": "Declared Limitation Codes",
      "type": "array"
    },
    "default_task": {
      "$ref": "#/$defs/DefaultTaskBinding"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "effect_ceiling": {
      "$ref": "#/$defs/EffectCeiling"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnterpriseSeedGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "governance": {
      "$ref": "#/$defs/GovernanceBinding"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "requested_growth_level": {
      "$ref": "#/$defs/GrowthLevel"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "runtime_compatibility": {
      "$ref": "#/$defs/RuntimeCompatibilityDeclaration"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orgrebase.enterprise-seed-profile.v1",
      "default": "orgrebase.enterprise-seed-profile.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "$ref": "#/$defs/SeedSourceRoot"
      },
      "title": "Source Roots",
      "type": "array"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "profile_id",
    "revision",
    "scenario_id",
    "organization_id",
    "synthetic",
    "source_roots",
    "components",
    "governance",
    "default_task",
    "effect_ceiling",
    "data_class",
    "requested_growth_level",
    "runtime_compatibility",
    "declared_limitation_codes"
  ],
  "title": "EnterpriseSeedProfile",
  "type": "object"
}
