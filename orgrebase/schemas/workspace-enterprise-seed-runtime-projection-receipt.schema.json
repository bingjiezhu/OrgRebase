          "type": "string"
        },
        "component_kind": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "runtime_projection_digest": {
          "title": "Runtime Projection Digest",
          "type": "string"
        },
