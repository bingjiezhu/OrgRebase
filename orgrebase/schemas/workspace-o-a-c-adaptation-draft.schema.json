{
  "$defs": {
    "CandidateSemanticMapping": {
      "additionalProperties": false,
      "properties": {
        "adaptation_run_id": {
          "minLength": 1,
          "title": "Adaptation Run Id",
          "type": "string"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "canonical_target_writes": {
          "const": 0,
          "default": 0,
          "title": "Canonical Target Writes",
          "type": "integer"
        },
        "component_kind": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "declared_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Declared Unknowns",
          "type": "array"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "effect_ceiling": {
          "const": "ZERO_EXTERNAL_EFFECTS",
          "default": "ZERO_EXTERNAL_EFFECTS",
          "title": "Effect Ceiling",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "orgrebase.oac-candidate-semantic-mapping.v1",
          "default": "orgrebase.oac-candidate-semantic-mapping.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_root_ref": {
          "minLength": 1,
          "title": "Source Root Ref",
          "type": "string"
        },
        "target_oac_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Oac Paths",
          "type": "array"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "adaptation_run_id",
        "component_kind",
        "source_root_ref",
        "source_digest",
        "producer",
        "task_id",
        "target_oac_paths"
      ],
      "title": "CandidateSemanticMapping",
      "type": "object"
    },
    "OACAdaptationGap": {
      "additionalProperties": false,
      "properties": {
        "canonical_target_writes": {
          "const": 0,
          "default": 0,
          "title": "Canonical Target Writes",
          "type": "integer"
        },
        "component_kind": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "owner_ref": {
          "minLength": 1,
          "title": "Owner Ref",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "resolution_gate_ref": {
          "minLength": 1,
          "title": "Resolution Gate Ref",
          "type": "string"
        },
        "schema_version": {
          "const": "orgrebase.oac-adaptation-gap.v1",
          "default": "orgrebase.oac-adaptation-gap.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "status": {
          "const": "OPEN",
          "default": "OPEN",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "component_kind",
        "reason_code",
        "source_ref",
        "owner_ref",
        "resolution_gate_ref"
      ],
      "title": "OACAdaptationGap",
      "type": "object"
    },
    "OACDependencyProjectionBinding": {
      "additionalProperties": false,
      "description": "One exact Workspace edge to portable OAC edge content binding.",
      "properties": {
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "oac_edge_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Oac Edge Digest",
          "type": "string"
        },
        "oac_edge_id": {
          "minLength": 1,
          "title": "Oac Edge Id",
          "type": "string"
        },
        "schema_version": {
          "const": "orgrebase.oac-dependency-projection-binding.v1",
          "default": "orgrebase.oac-dependency-projection-binding.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_edge_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workspace Edge Digest",
          "type": "string"
        },
        "workspace_edge_id": {
          "minLength": 1,
          "title": "Workspace Edge Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_edge_id",
        "workspace_edge_digest",
        "oac_edge_id",
        "oac_edge_digest"
      ],
      "title": "OACDependencyProjectionBinding",
      "type": "object"
    },
    "OACDependencyProjectionReceipt": {
      "additionalProperties": false,
      "description": "Content-addressed proof of the bounded dependency projection.\n\nThe receipt binds exact Enterprise Pack bytes to the already compiled\nWorkspace universe and then to a portable OAC edge set.  It deliberately\ncarries no impact result and grants no canonical-write authority.",
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/OACDependencyProjectionBinding"
          },
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "canonical_target_writes": {
          "const": 0,
          "default": 0,
          "title": "Canonical Target Writes",
          "type": "integer"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "edge_count": {
          "exclusiveMinimum": 0,
          "title": "Edge Count",
          "type": "integer"
        },
        "mapping_rule_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Rule Set Digest",
          "type": "string"
        },
        "oac_edge_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Oac Edge Set Digest",
          "type": "string"
        },
        "organization_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Organization Snapshot Digest",
          "type": "string"
        },
        "pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Pack Digest",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "orgrebase.oac-dependency-projection-receipt.v1",
          "default": "orgrebase.oac-dependency-projection-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_dependency_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Dependency Digest",
          "type": "string"
        },
        "verdict": {
          "const": "PASS",
          "default": "PASS",
          "title": "Verdict",
          "type": "string"
        },
        "workspace_edge_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workspace Edge Set Digest",
          "type": "string"
        },
        "workspace_universe_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workspace Universe Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_digest",
        "pack_digest",
        "source_dependency_digest",
        "mapping_rule_set_digest",
        "workspace_universe_digest",
        "workspace_edge_set_digest",
        "organization_snapshot_digest",
        "oac_edge_set_digest",
        "edge_count",
        "bindings"
      ],
      "title": "OACDependencyProjectionReceipt",
      "type": "object"
    },
    "OACOwnerReviewComponent": {
      "additionalProperties": false,
      "description": "One safe, business-facing slice of the source-to-contract review.",
      "properties": {
        "completeness": {
          "minLength": 1,
          "title": "Completeness",
          "type": "string"
        },
        "component_kind": {
          "$ref": "#/$defs/SeedComponentKind"
        },
        "contract_effects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Contract Effects",
          "type": "array"
        },
        "declared_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Declared Unknowns",
          "type": "array"
        },
        "observed_item_count": {
          "minimum": 0,
          "title": "Observed Item Count",
          "type": "integer"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "responsible_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Responsible Refs",
          "type": "array"
        },
        "sample_items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sample Items",
          "type": "array"
        },
        "source_root_ref": {
          "minLength": 1,
          "title": "Source Root Ref",
          "type": "string"
        }
      },
      "required": [
        "component_kind",
        "completeness",
        "source_root_ref",
        "observed_item_count",
        "contract_effects"
      ],
      "title": "OACOwnerReviewComponent",
      "type": "object"
    },
    "OACOwnerReviewGate": {
      "additionalProperties": false,
      "properties": {
        "adaptation_run_id": {
          "minLength": 1,
          "title": "Adaptation Run Id",
          "type": "string"
        },
        "canonical_target_writes": {
          "const": 0,
          "default": 0,
          "title": "Canonical Target Writes",
          "type": "integer"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "mapping_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Set Digest",
          "type": "string"
        },
        "not_before": {
          "minLength": 1,
          "title": "Not Before",
          "type": "string"
        },
        "not_before_epoch_ms": {
          "minimum": 0,
          "title": "Not Before Epoch Ms",
          "type": "integer"
        },
        "organization_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Organization Snapshot Digest",
          "type": "string"
        },
        "organizational_demand_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Organizational Demand Digest",
          "type": "string"
        },
        "owner_ref": {
          "minLength": 1,
          "title": "Owner Ref",
          "type": "string"
        },
        "owner_review_summary_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Owner Review Summary Digest",
          "type": "string"
        },
        "pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Pack Digest",
          "type": "string"
        },
        "prepared_at": {
          "minLength": 1,
          "title": "Prepared At",
          "type": "string"
        },
        "prepared_at_epoch_ms": {
          "minimum": 0,
          "title": "Prepared At Epoch Ms",
          "type": "integer"
        },
        "profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "review_duration_ms": {
          "minimum": 4000,
          "title": "Review Duration Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "orgrebase.oac-owner-review-gate.v1",
          "default": "orgrebase.oac-owner-review-gate.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "adaptation_run_id",
        "mapping_set_digest",
        "organization_snapshot_digest",
        "organizational_demand_digest",
        "owner_review_summary_digest",
        "profile_digest",
        "pack_digest",
        "owner_ref",
        "review_duration_ms",
        "prepared_at_epoch_ms",
        "not_before_epoch_ms",
        "prepared_at",
        "not_before"
      ],
      "title": "OACOwnerReviewGate",
      "type": "object"
    },
    "OACOwnerReviewSummary": {
      "additionalProperties": false,
      "description": "Human-readable approval subject derived from the exact admitted Pack.\n\nThe summary is deliberately a safe projection: it carries no local paths,\nraw private values, provider identifiers, or authority to mutate business\nstate.  Its digest is bound into the time gate, approval, adapter capsule,\nand therefore the later Workspace activation/consumption chain.",
      "properties": {
        "adaptation_run_id": {
          "minLength": 1,
          "title": "Adaptation Run Id",
          "type": "string"
        },
        "approval_effects": {
          "default": [
            "ACTIVATE_EXACT_ORGANIZATION_CONTRACT",
            "ALLOW_EXACT_WORKSPACE_FORMATION_GATE"
          ],
          "items": {
            "type": "string"
          },
          "title": "Approval Effects",
          "type": "array"
        },
        "authority_refs": {
          "items": {
            "type": "string"
          },
          "title": "Authority Refs",
          "type": "array"
        },
        "candidate_mapping_set_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Mapping Set Digest",
          "type": "string"
        },
        "canonical_target_writes": {
          "const": 0,
          "default": 0,
          "title": "Canonical Target Writes",
          "type": "integer"
        },
        "capability_refs": {
          "items": {
            "type": "string"
          },
          "title": "Capability Refs",
          "type": "array"
        },
        "change_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Change Kinds",
          "type": "array"
        },
        "component_reviews": {
          "items": {
            "$ref": "#/$defs/OACOwnerReviewComponent"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Component Reviews",
          "type": "array"
        },
        "data_class": {
          "$ref": "#/$defs/SeedDataClass"
        },
        "decision_owner_ref": {
          "minLength": 1,
          "title": "Decision Owner Ref",
          "type": "string"
        },
        "declared_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Declared Unknowns",
          "type": "array"
        },
        "dependency_edge_count": {
          "minimum": 0,
          "title": "Dependency Edge Count",
          "type": "integer"
        },
        "dependency_owner_refs": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Owner Refs",
          "type": "array"
        },
        "dependency_target_count": {
          "minimum": 0,
          "title": "Dependency Target Count",
          "type": "integer"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "domain_ids": {
          "items": {
            "type": "string"
          },
          "title": "Domain Ids",
          "type": "array"
        },
        "effect_ceiling": {
          "const": "ZERO_EXTERNAL_EFFECTS",
          "default": "ZERO_EXTERNAL_EFFECTS",
          "title": "Effect Ceiling",
          "type": "string"
        },
        "evidence_label": {
          "enum": [
            "CONTROLLED_SYNTHETIC_ENTERPRISE_INPUT",
            "PUBLIC_DATA_INPUT",
            "ENTERPRISE_INTERNAL_DECLARED_INPUT",
            "ENTERPRISE_CONFIDENTIAL_DECLARED_INPUT"
          ],
          "title": "Evidence Label",
          "type": "string"
        },
        "fact_count": {
          "minimum": 0,
          "title": "Fact Count",
          "type": "integer"
        },
        "input_format": {
          "const": "FIVE_CLASS_JSON_ENTERPRISE_PACK",
          "default": "FIVE_CLASS_JSON_ENTERPRISE_PACK",
          "title": "Input Format",
          "type": "string"
        },
        "non_effects": {
          "default": [
            "NO_QUOTE_BUSINESS_APPROVAL",
            "NO_EXTERNAL_SYSTEM_WRITE",
            "NO_AGENT_AUTHORITY_EXPANSION"
          ],
          "items": {
            "type": "string"
          },
          "title": "Non Effects",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Pack Digest",
          "type": "string"
        },
        "pack_ref": {
          "minLength": 1,
          "title": "Pack Ref",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "profile_ref": {
          "minLength": 1,
          "title": "Profile Ref",
          "type": "string"
        },
        "proposer_reviewer_separated": {
          "const": true,
          "default": true,
          "title": "Proposer Reviewer Separated",
          "type": "boolean"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "orgrebase.oac-owner-review-summary.v1",
          "default": "orgrebase.oac-owner-review-summary.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "task_scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Task Scope",
          "type": "object"
        }
      },
      "required": [
        "adaptation_run_id",
        "organization_id",
        "profile_ref",
        "profile_digest",
        "pack_ref",
        "pack_digest",
        "data_class",
        "synthetic",
        "evidence_label",
        "task_scope",
        "domain_ids",
        "fact_count",
        "authority_refs",
        "capability_refs",
        "dependency_target_count",
        "dependency_edge_count",
        "dependency_owner_refs",
        "change_kinds",
        "component_reviews",
        "candidate_mapping_set_digest",
        "decision_owner_ref"
      ],
      "title": "OACOwnerReviewSummary",
      "type": "object"
    },
    "SeedComponentKind": {
      "enum": [
        "DOMAIN",
        "KNOWLEDGE",
        "AUTHORITY",
        "CAPABILITY",
        "DEPENDENCY"
      ],
      "title": "SeedComponentKind",
      "type": "string"
    },
    "SeedDataClass": {
      "enum": [
        "SYNTHETIC_FIXTURE",
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL"
      ],
      "title": "SeedDataClass",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-o-a-c-adaptation-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adaptation_epoch": {
      "const": "DEPENDENCY_BOUND_R2",
      "default": "DEPENDENCY_BOUND_R2",
      "title": "Adaptation Epoch",
      "type": "string"
    },
    "adaptation_run_id": {
      "minLength": 1,
      "title": "Adaptation Run Id",
      "type": "string"
    },
    "candidate_mappings": {
      "items": {
        "$ref": "#/$defs/CandidateSemanticMapping"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Candidate Mappings",
      "type": "array"
    },
    "canonical_target_writes": {
      "const": 0,
      "default": 0,
      "title": "Canonical Target Writes",
      "type": "integer"
    },
    "dependency_projection_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/OACDependencyProjectionReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "effect_ceiling": {
      "const": "ZERO_EXTERNAL_EFFECTS",
      "default": "ZERO_EXTERNAL_EFFECTS",
      "title": "Effect Ceiling",
      "type": "string"
    },
    "execution_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Run Id"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OACAdaptationGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "human_authority_ref": {
      "minLength": 1,
      "title": "Human Authority Ref",
      "type": "string"
    },
    "mapping_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Set Digest",
      "type": "string"
    },
    "oac_plan_certificate_produced": {
      "const": false,
      "default": false,
      "title": "Oac Plan Certificate Produced",
      "type": "boolean"
    },
    "oac_plan_produced": {
      "const": false,
      "default": false,
      "title": "Oac Plan Produced",
      "type": "boolean"
    },
    "oac_public_validation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oac Public Validation"
    },
    "oac_runtime_invoked": {
      "const": false,
      "default": false,
      "title": "Oac Runtime Invoked",
      "type": "boolean"
    },
    "organization_snapshot": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization Snapshot"
    },
    "organizational_demand": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organizational Demand"
    },
    "owner_review_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/OACOwnerReviewSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pack_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
