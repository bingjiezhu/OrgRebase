{
  "$id": "https://orgrebase.local/schemas/workspace-promotion-preview-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_target_writes": {
      "const": 0,
      "title": "Canonical Target Writes",
      "type": "integer"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "kind": {
      "enum": [
        "launch_date",
        "currency"
      ],
      "title": "Kind",
      "type": "string"
    },
    "owner_id": {
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "promotion_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Promotion Digest",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "orgrebase.promotion-preview-binding.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "workspace_preview_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Workspace Preview Artifact Digest",
      "type": "string"
    },
    "workspace_preview_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Workspace Preview Digest",
      "type": "string"
    }
  },
  "required": [
    "digest",
    "schema_version",
    "run_id",
    "kind",
    "promotion_digest",
    "workspace_preview_artifact_digest",
    "workspace_preview_digest",
    "snapshot_digest",
    "owner_id",
    "canonical_target_writes"
  ],
  "title": "PromotionPreviewBinding",
  "type": "object"
}
