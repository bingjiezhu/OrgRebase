{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.dev/schemas/workspace-public-causal-overlay.schema.json",
  "title": "Public Process Experimenter-Injected Causal Overlay",
  "$defs": {
    "ref": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "evidence_class",
    "claim_boundary",
    "projection_digest",
    "policy_change",
    "target_universe",
    "ground_truth",
    "dependency_claims",
    "controlled_missingness",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.workspace-public-causal-overlay.v1"},
    "scenario_id": {"$ref": "#/$defs/ref"},
    "evidence_class": {"const": "PUBLIC_SOURCE_DERIVED_SYNTHETIC"},
    "claim_boundary": {"const": "INJECTED_CAUSAL_GROUND_TRUTH_NOT_OBSERVED_ENTERPRISE_CAUSALITY_OR_ROI"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "policy_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_object_ref", "changed_field", "effective_at", "old_value", "new_value", "source_attribute_origin", "policy_interpretation_origin"],
      "properties": {
        "changed_object_ref": {"$ref": "#/$defs/ref"},
        "changed_field": {"$ref": "#/$defs/ref"},
        "effective_at": {"type": "string", "format": "date-time"},
        "old_value": {"type": "number"},
        "new_value": {"type": "number"},
        "source_attribute_origin": {"const": "OBSERVED"},
        "policy_interpretation_origin": {"const": "EXPERIMENTER_INJECTED"}
      }
    },
    "target_universe": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_affected", "expected_unaffected", "basis", "origin"],
      "properties": {
        "expected_affected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "expected_unaffected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "basis": {"const": "INJECTED_EXACT_PRODUCT_READ_RULE_OVER_OBSERVED_OBJECT_RELATIONS"},
        "origin": {"const": "EXPERIMENTER_INJECTED"}
      }
    },
    "dependency_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "target_ref", "dependency_kind", "origin", "observed_support_path"],
        "properties": {
          "source_ref": {"$ref": "#/$defs/ref"},
          "target_ref": {"$ref": "#/$defs/ref"},
          "dependency_kind": {"enum": ["ACTUAL_READ", "DECLARED", "INFERRED", "EXPLICIT_NON_DEPENDENCY", "UNKNOWN"]},
          "origin": {"enum": ["OBSERVED", "DERIVED", "EXPERIMENTER_INJECTED", "MISSING"]},
          "observed_support_path": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
        }
      }
    },
    "controlled_missingness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_target_refs", "reason", "origin"],
      "properties": {
        "missing_target_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "reason": {"const": "EXERCISE_UNKNOWN_INSTEAD_OF_FALSE_UNAFFECTED"},
        "origin": {"const": "MISSING"}
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  }
}
