{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.dev/schemas/workspace-public-process-mapping.schema.json",
  "title": "Public Process to OAC Dependency Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_id",
    "source_dataset",
    "evidence_class",
    "claim_boundary",
    "object_roles",
    "relation_rules",
    "missing_semantics",
    "forbidden_promotions",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.workspace-public-process-mapping.v1"},
    "mapping_id": {"type": "string", "minLength": 1},
    "source_dataset": {"const": "10.5281/zenodo.8337464/order-management.sqlite"},
    "evidence_class": {"const": "PUBLIC_PROCESS_OBSERVED_DERIVED"},
    "claim_boundary": {"const": "RELATION_MAPPING_FOR_MECHANISM_BENCHMARK_NOT_ENTERPRISE_SEMANTICS"},
    "object_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_object_type", "benchmark_role", "origin"],
        "properties": {
          "source_object_type": {"type": "string", "minLength": 1},
          "benchmark_role": {"enum": ["CHANGE_SOURCE", "WORK_TARGET", "DEPENDENCY_CARRIER", "ORGANIZATIONAL_CONTEXT"]},
          "origin": {"const": "DERIVED"}
        }
      }
    },
    "relation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_qualifier", "dependency_kind", "causal_traversal", "origin"],
        "properties": {
          "source_qualifier": {"type": "string", "minLength": 1},
          "dependency_kind": {"enum": ["INFERRED", "ORGANIZATIONAL_CONTEXT"]},
          "causal_traversal": {"type": "boolean"},
          "origin": {"const": "DERIVED"},
          "warning": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_semantics": {"const": "UNKNOWN"},
    "forbidden_promotions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "contains": {"const": "OBSERVED_ENTERPRISE_SHADOW"}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
