{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.dev/schemas/workspace-public-real-process-projection.schema.json",
  "title": "BPI 2019 Real Process Projection",
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "trace_index", "event_index"],
      "properties": {
        "source_sha256": {"const": "sha256:af63bc687fc4152f2123b05c3af7772b37ef3fce2d3f67f812666c9e356baae7"},
        "trace_index": {"type": "integer", "minimum": 1},
        "event_index": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_id", "data_domain", "evidence_class", "claim_ceiling",
    "claim_boundary", "upstream", "task_contract", "provenance_legend", "selection",
    "queries", "observed_events", "digest"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.workspace-public-real-process-projection.v1"},
    "projection_id": {"const": "bpi2019-change-price-30d-real-process-v1"},
    "data_domain": {"const": "PURCHASE_TO_PAY"},
    "evidence_class": {"const": "PUBLIC_REAL_ANONYMIZED_ENTERPRISE_EVENT_LOG"},
    "claim_ceiling": {"const": "PUBLIC_REAL_PROCESS_RULE_DERIVED_MECHANISM_VALIDATION"},
    "claim_boundary": {"const": "NOT_REAL_QUOTE_DATA_NOT_CAUSAL_GROUND_TRUTH_NOT_REALIZED_ROI_NOT_PRODUCTION"},
    "upstream": {
      "type": "object",
      "required": ["status", "doi", "file_id", "size_bytes", "md5", "sha256", "license", "raw_bytes_in_repository"],
      "properties": {
        "status": {"const": "PASS"},
        "doi": {"const": "10.4121/uuid:d06aff4b-79f0-45e6-8ec8-e19730c248f1"},
        "file_id": {"const": "24072995"},
        "size_bytes": {"const": 728558522},
        "md5": {"const": "md5:4eb909242351193a61e1c15b9c3cc814"},
        "sha256": {"const": "sha256:af63bc687fc4152f2123b05c3af7772b37ef3fce2d3f67f812666c9e356baae7"},
        "license": {"const": "CC-BY-4.0"},
        "raw_bytes_in_repository": {"const": false}
      }
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "change_event_type", "window_days", "downstream_event_types",
        "candidate_universe", "query_ground_truth", "query_ground_truth_available_to_strategy",
        "selection_rule"
      ],
      "properties": {
        "task_id": {"const": "BPI2019_CHANGE_PRICE_30D_DOWNSTREAM_V1"},
        "change_event_type": {"const": "Change Price"},
        "window_days": {"const": 30},
        "downstream_event_types": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "candidate_universe": {"const": "SAME_VENDOR_EVENTS_AFTER_CHANGE_THROUGH_WINDOW_END"},
        "query_ground_truth": {"const": "SAME_PURCHASE_DOCUMENT_AND_ITEM_EVENTS_IN_CANDIDATE_UNIVERSE"},
        "query_ground_truth_available_to_strategy": {"const": false},
        "selection_rule": {"$ref": "#/$defs/nonempty"}
      }
    },
    "provenance_legend": {
      "const": [
        "PUBLIC_REAL_ANONYMIZED_ENTERPRISE_EVENT_LOG",
        "TASK_DEFINED_QUERY_GROUND_TRUTH",
        "OBSERVED_DOWNSTREAM_EVENT_PROXY",
        "PROVIDER_DOCUMENTED_RULE_DERIVED"
      ]
    },
    "selection": {"type": "object", "required": ["traces_scanned", "events_scanned", "selected_queries", "ordering", "outcome_blind_ordering"]},
    "queries": {
      "type": "array",
      "minItems": 128,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id", "selection_digest", "case_ref", "company_ref", "vendor_ref",
          "purchase_document_ref", "item_ref", "item_category", "source_system_ref",
          "document_type", "purchasing_category", "item_type", "gr_based_invoice_verification",
          "goods_receipt_expected", "change_event", "window_end", "candidate_event_refs"
        ],
        "properties": {
          "query_id": {"$ref": "#/$defs/nonempty"},
          "selection_digest": {"$ref": "#/$defs/digest"},
          "case_ref": {"$ref": "#/$defs/nonempty"},
          "company_ref": {"$ref": "#/$defs/nonempty"},
          "vendor_ref": {"$ref": "#/$defs/nonempty"},
          "purchase_document_ref": {"$ref": "#/$defs/nonempty"},
          "item_ref": {"$ref": "#/$defs/nonempty"},
          "item_category": {"type": "string"},
          "source_system_ref": {"$ref": "#/$defs/nonempty"},
          "document_type": {"type": "string"},
          "purchasing_category": {"type": "string"},
          "item_type": {"type": "string"},
          "gr_based_invoice_verification": {"type": ["boolean", "null"]},
          "goods_receipt_expected": {"type": ["boolean", "null"]},
          "change_event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_ref", "event_type", "occurred_at", "actor_ref", "cumulative_net_worth_eur", "evidence_class", "lineage"],
            "properties": {
              "event_ref": {"$ref": "#/$defs/nonempty"},
              "event_type": {"const": "Change Price"},
              "occurred_at": {"type": "string", "format": "date-time"},
              "actor_ref": {"type": "string"},
              "cumulative_net_worth_eur": {"type": ["number", "null"]},
              "evidence_class": {"const": "PUBLIC_REAL_ANONYMIZED_ENTERPRISE_EVENT_LOG"},
              "lineage": {"$ref": "#/$defs/lineage"}
            }
          },
          "window_end": {"type": "string", "format": "date-time"},
          "candidate_event_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
        }
      }
    },
    "observed_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_ref", "case_ref", "company_ref", "vendor_ref", "purchase_document_ref",
          "item_ref", "event_type", "occurred_at", "actor_ref", "cumulative_net_worth_eur",
          "evidence_class", "lineage"
        ],
        "properties": {
          "event_ref": {"$ref": "#/$defs/nonempty"},
          "case_ref": {"$ref": "#/$defs/nonempty"},
          "company_ref": {"$ref": "#/$defs/nonempty"},
          "vendor_ref": {"$ref": "#/$defs/nonempty"},
          "purchase_document_ref": {"$ref": "#/$defs/nonempty"},
          "item_ref": {"$ref": "#/$defs/nonempty"},
          "event_type": {"$ref": "#/$defs/nonempty"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "actor_ref": {"type": "string"},
          "cumulative_net_worth_eur": {"type": ["number", "null"]},
          "evidence_class": {"const": "OBSERVED_DOWNSTREAM_EVENT_PROXY"},
          "lineage": {"$ref": "#/$defs/lineage"}
        }
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  }
}
