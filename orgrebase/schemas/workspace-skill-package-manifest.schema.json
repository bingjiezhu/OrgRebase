{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/workspace-skill-package-manifest.schema.json",
  "title": "SkillPackageManifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "sha256": {"$ref": "#/$defs/Digest"}
      }
    }
  },
  "required": [
    "schema_version", "package_id", "name", "version", "entry_point", "resources",
    "program_content_digest", "input_schema_ref", "output_schema_ref", "permissions",
    "dependencies", "evaluation", "release_artifact", "license", "provenance_refs",
    "manifest_digest"
  ],
  "if": {
    "required": ["license"],
    "properties": {"license": {"const": "Apache-2.0"}}
  },
  "then": {"required": ["license_files"]},
  "properties": {
    "schema_version": {"const": "orgrebase.skill-package-manifest.v1"},
    "package_id": {"type": "string", "minLength": 1},
    "name": {"enum": ["enterprise-quote-compose", "structured-domain-handoff", "enterprise-launch-readiness"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entry_point": {"enum": ["QUOTE_COMPOSE_V1", "STRUCTURED_DOMAIN_HANDOFF_V1", "LAUNCH_READINESS_V1"]},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "contract", "program"],
      "properties": {
        "skill": {"$ref": "#/$defs/Resource"},
        "contract": {"$ref": "#/$defs/Resource"},
        "program": {"$ref": "#/$defs/Resource"}
      }
    },
    "program_content_digest": {"$ref": "#/$defs/Digest"},
    "input_schema_ref": {"type": "string", "minLength": 1},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tools", "side_effects", "effect_ceiling"],
      "properties": {
        "allowed_tools": {"type": "array", "maxItems": 0},
        "side_effects": {"type": "array", "maxItems": 0},
        "effect_ceiling": {"const": "CANDIDATE_ONLY"}
      }
    },
    "dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/Digest"}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitions", "functional_min_pass_rate", "security_min_pass_rate", "target_writes_max"],
      "properties": {
        "partitions": {
          "const": ["REPLAY", "HELD_OUT", "NEGATIVE_TRANSFER", "PERMISSION", "INJECTION", "MALFORMED", "RESOURCE_OR_DEADLINE", "CANARY"]
        },
        "functional_min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "security_min_pass_rate": {"const": 1.0},
        "target_writes_max": {"const": 0}
      }
    },
    "release_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_candidate_ref", "source_candidate_digest", "source_candidate_executable", "predecessor_package_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_candidate_ref": {"type": ["string", "null"]},
        "source_candidate_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
        "source_candidate_executable": {"const": false},
        "predecessor_package_digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "license": {"enum": ["PolyForm-Noncommercial-1.0.0", "Apache-2.0"]},
    "license_files": {
      "description": "Non-executable, digest-bound license attachments; no Skill or business authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["LICENSE"],
      "properties": {
        "LICENSE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "media_type", "content_base64", "size_bytes", "sha256"],
          "properties": {
            "encoding": {"const": "base64"},
            "media_type": {"const": "text/plain; charset=utf-8"},
            "content_base64": {"type": "string", "minLength": 1, "maxLength": 45000},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 32768},
            "sha256": {"$ref": "#/$defs/Digest"}
          }
        }
      }
    },
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "manifest_digest": {"$ref": "#/$defs/Digest"}
  }
}
