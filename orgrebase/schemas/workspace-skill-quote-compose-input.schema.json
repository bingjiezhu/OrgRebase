{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/workspace-skill-quote-compose-input.schema.json",
  "title": "QuoteComposeInput",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    }
  },
  "required": [
    "skill_partition",
    "candidate_program_digest_required",
    "dependency_tool_receipt_digest",
    "dependency_result_digest",
    "coalition_result_binding_digest",
    "domain_result_digests"
  ],
  "properties": {
    "skill_partition": {
      "enum": ["replay", "held_out", "negative_transfer", "canary"]
    },
    "candidate_program_digest_required": {"$ref": "#/$defs/Digest"},
    "dependency_tool_receipt_digest": {"$ref": "#/$defs/Digest"},
    "dependency_result_digest": {"$ref": "#/$defs/Digest"},
    "coalition_result_binding_digest": {"$ref": "#/$defs/Digest"},
    "domain_result_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "legal", "finance", "gtm"],
      "properties": {
        "product": {"$ref": "#/$defs/Digest"},
        "legal": {"$ref": "#/$defs/Digest"},
        "finance": {"$ref": "#/$defs/Digest"},
        "gtm": {"$ref": "#/$defs/Digest"}
      }
    },
    "permission_expansion": {"type": "boolean"},
    "request_restricted_source": {"type": "boolean"},
    "target_write_requested": {"type": "boolean"},
    "prompt_injection": {"type": "boolean"},
    "malformed_input": {"type": "boolean"},
    "deadline_expired": {"type": "boolean"},
    "resource_exhausted": {"type": "boolean"},
    "stale_input": {"type": "boolean"}
  }
}
