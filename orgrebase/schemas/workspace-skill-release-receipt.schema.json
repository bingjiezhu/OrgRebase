{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/workspace-skill-release-receipt.schema.json",
  "title": "SkillReleaseReceipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "State": {"enum": ["DRAFT", "EVALUATED", "SHADOW", "CANARY", "ACTIVE", "REQUALIFICATION_REQUIRED", "QUARANTINED", "ROLLBACK_DECISION_RECORDED"]}
  },
  "required": [
    "schema_version", "id", "event_index", "event_type", "skill_name",
    "release_artifact_id", "package_digest", "predecessor_package_digest",
    "effective_package_digest", "predecessor_executable", "restoration_status",
    "source_candidate_ref", "source_candidate_digest",
    "source_candidate_executable", "evaluation_receipt_digest",
    "evaluation_premise_lock_digest", "previous_receipt_digest", "from_state",
    "to_state", "actor_id", "reason_codes", "changed_dependency_refs", "created_at", "digest"
  ],
  "properties": {
    "schema_version": {"const": "orgrebase.skill-release-receipt.v1"},
    "id": {"type": "string", "minLength": 1},
    "event_index": {"type": "integer", "minimum": 1},
    "event_type": {"enum": ["RELEASE", "REQUALIFICATION", "QUARANTINE", "ROLLBACK_DECISION"]},
    "skill_name": {"type": "string", "minLength": 1},
    "release_artifact_id": {"type": "string", "minLength": 1},
    "package_digest": {"$ref": "#/$defs/Digest"},
    "predecessor_package_digest": {"$ref": "#/$defs/Digest"},
    "effective_package_digest": {"$ref": "#/$defs/Digest"},
    "predecessor_executable": {"const": false},
    "restoration_status": {"enum": ["NOT_APPLICABLE", "NOT_RUN"]},
    "source_candidate_ref": {"type": ["string", "null"]},
    "source_candidate_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
    "source_candidate_executable": {"const": false},
    "evaluation_receipt_digest": {"$ref": "#/$defs/Digest"},
    "evaluation_premise_lock_digest": {"$ref": "#/$defs/Digest"},
    "previous_receipt_digest": {"anyOf": [{"$ref": "#/$defs/Digest"}, {"type": "null"}]},
    "from_state": {"$ref": "#/$defs/State"},
    "to_state": {"$ref": "#/$defs/State"},
    "actor_id": {"const": "authority:skill-registry"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "changed_dependency_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "digest": {"$ref": "#/$defs/Digest"}
  }
}
