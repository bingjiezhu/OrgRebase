{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgrebase.local/schemas/workspace-skill-rollback-execution-receipt.schema.json",
  "title": "SkillPredecessorRollbackExecutionReceipt",
  "description": "Append-only authority receipt proving a direct predecessor release-head transition and an exact restricted-program invocation.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "event_index",
    "event_type",
    "run_id",
    "task_id",
    "delegation_id",
    "skill_name",
    "actor_id",
    "authority_scope",
    "idempotency_key",
    "rollback_binding_digest",
    "from_package_id",
    "from_package_digest",
    "declared_predecessor_package_digest",
    "predecessor_package_id",
    "effective_package_digest",
    "predecessor_entry_point",
    "predecessor_program_digest",
    "predecessor_contract_digest",
    "predecessor_resource_digests",
    "predecessor_source_provenance_digest",
    "source_wheel_digest",
    "current_invocation_receipt_digest",
    "current_input_digest",
    "current_output_digest",
    "dependency_tool_receipt_digest",
    "dependency_result_digest",
    "predecessor_input_digest",
    "predecessor_output_digest",
    "predecessor_action",
    "outcome",
    "lineage_status",
    "restoration_status",
    "candidate_only",
    "target_writes",
    "previous_receipt_digest",
    "reason_codes",
    "created_at",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "orgrebase.skill-predecessor-rollback-execution-receipt.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^skill-predecessor-rollback:[0-9a-f]{64}$"
    },
    "event_index": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "const": "EXECUTABLE_PREDECESSOR_ROLLBACK"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_name": {
      "const": "enterprise-quote-compose"
    },
    "actor_id": {
      "const": "authority:skill-registry"
    },
    "authority_scope": {
      "const": [
        "skill:release-head:rollback",
        "skill:predecessor:invoke"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "rollback_binding_digest": {
      "$ref": "#/$defs/Digest"
    },
    "from_package_id": {
      "type": "string",
      "minLength": 1
    },
    "from_package_digest": {
      "$ref": "#/$defs/Digest"
    },
    "declared_predecessor_package_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_package_id": {
      "const": "skill-package:enterprise-quote-compose@1.3.0"
    },
    "effective_package_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_entry_point": {
      "const": "QUOTE_COMPOSE_V1"
    },
    "predecessor_program_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_contract_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_resource_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "input_schema",
        "manifest",
        "output_schema",
        "program",
        "skill"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/Digest"
        },
        "input_schema": {
          "$ref": "#/$defs/Digest"
        },
        "manifest": {
          "$ref": "#/$defs/Digest"
        },
        "output_schema": {
          "$ref": "#/$defs/Digest"
        },
        "program": {
          "$ref": "#/$defs/Digest"
        },
        "skill": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "predecessor_source_provenance_digest": {
      "$ref": "#/$defs/Digest"
    },
    "source_wheel_digest": {
      "$ref": "#/$defs/Digest"
    },
    "current_invocation_receipt_digest": {
      "$ref": "#/$defs/Digest"
    },
    "current_input_digest": {
      "$ref": "#/$defs/Digest"
    },
    "current_output_digest": {
      "$ref": "#/$defs/Digest"
    },
    "dependency_tool_receipt_digest": {
      "$ref": "#/$defs/Digest"
    },
    "dependency_result_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_input_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_output_digest": {
      "$ref": "#/$defs/Digest"
    },
    "predecessor_action": {
      "enum": [
        "APPLY_QUOTE",
        "KEEP_CURRENT",
        "DENY",
        "SAFE_ABSTAIN",
        "ABSTAIN",
        "CANARY"
      ]
    },
    "outcome": {
      "enum": [
        "SUCCESS",
        "ABSTAIN",
        "DENY"
      ]
    },
    "lineage_status": {
      "const": "DIRECT_DECLARED_PREDECESSOR"
    },
    "restoration_status": {
      "const": "EXECUTED_AND_INVOKED"
    },
    "candidate_only": {
      "const": true
    },
    "target_writes": {
      "const": 0
    },
    "previous_receipt_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "$ref": "#/$defs/Digest"
    }
  }
}
