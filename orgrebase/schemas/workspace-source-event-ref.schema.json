{
  "$id": "https://orgrebase.local/schemas/workspace-source-event-ref.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_digest"
  ],
  "title": "SourceEventRef",
  "type": "object"
}
