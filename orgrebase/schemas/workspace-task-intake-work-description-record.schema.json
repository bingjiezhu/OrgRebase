{
  "$id": "https://orgrebase.local/schemas/workspace-task-intake-work-description-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Private employee work text bound to one run, approval, candidate and Formation. Never a business-fact or authority source.",
  "properties": {
    "digest": { "default": "", "type": "string" },
    "schema_version": { "const": "orgrebase.workspace-task-intake-work-description-record.v1", "default": "orgrebase.workspace-task-intake-work-description-record.v1" },
    "status": { "const": "PRIVATE_RECORD_RETAINED", "default": "PRIVATE_RECORD_RETAINED" },
    "run_id": { "minLength": 1, "type": "string" },
    "workspace_instance_nonce": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "actor_id": { "minLength": 1, "type": "string" },
    "work_description": { "minLength": 8, "maxLength": 500, "type": "string" },
    "prompt_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "prompt_length": { "minimum": 8, "maximum": 500, "type": "integer" },
    "prompt_utf8_bytes": { "minimum": 1, "maximum": 2048, "type": "integer" },
    "candidate_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "approval_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "formation_receipt_digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "quote_ref": { "minLength": 1, "type": "string" },
    "semantic_use": { "const": "TASK_INTENT_ONLY", "default": "TASK_INTENT_ONLY" },
    "contributes_business_facts": { "const": false, "default": false },
    "grants_authority": { "const": false, "default": false },
    "canonical_target_writes": { "const": 0, "default": 0 },
    "visibility": { "const": "AUTHORIZED_TASK_ACTOR_ONLY", "default": "AUTHORIZED_TASK_ACTOR_ONLY" },
    "included_in_state": { "const": false, "default": false },
    "included_in_public_evidence": { "const": false, "default": false },
    "included_in_events_or_otlp": { "const": false, "default": false },
    "claim_boundary": { "const": "PRIVATE_WORK_DESCRIPTION_NOT_BUSINESS_FACT_OR_WRITE_AUTHORITY", "default": "PRIVATE_WORK_DESCRIPTION_NOT_BUSINESS_FACT_OR_WRITE_AUTHORITY" }
  },
  "required": [
    "run_id",
    "workspace_instance_nonce",
    "actor_id",
    "work_description",
    "prompt_digest",
    "prompt_length",
    "prompt_utf8_bytes",
    "candidate_digest",
    "approval_digest",
    "formation_receipt_digest",
    "quote_ref"
  ],
  "title": "TaskIntakeWorkDescriptionRecord",
  "type": "object"
}
