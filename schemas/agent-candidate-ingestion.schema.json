{
  "$defs": {
    "AgentCandidateDecision": {
      "additionalProperties": false,
      "properties": {
        "admitted_effects": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Admitted Effects",
          "type": "array"
        },
        "artifact_digest": {
          "title": "Artifact Digest",
          "type": "string"
        },
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "producer_worker": {
          "title": "Producer Worker",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "artifact_ref",
        "artifact_digest",
        "producer_worker",
        "decision",
        "reason_codes"
      ],
      "title": "AgentCandidateDecision",
      "type": "object"
    },
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/agent-candidate-ingestion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admitted_candidate_digests": {
      "items": {
        "type": "string"
      },
      "title": "Admitted Candidate Digests",
      "type": "array"
    },
    "change_set_digest": {
      "title": "Change Set Digest",
      "type": "string"
    },
    "claim_boundary": {
      "title": "Claim Boundary",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/AgentCandidateDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "live_receipt_digest": {
      "title": "Live Receipt Digest",
      "type": "string"
    },
    "nonce": {
      "title": "Nonce",
      "type": "string"
    },
    "orchestration_plan_digest": {
      "title": "Orchestration Plan Digest",
      "type": "string"
    },
    "preview_digest": {
      "title": "Preview Digest",
      "type": "string"
    },
    "rejected_candidate_digests": {
      "items": {
        "type": "string"
      },
      "title": "Rejected Candidate Digests",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "orgrebase.agent-candidate-ingestion.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "target_writes": {
      "title": "Target Writes",
      "type": "integer"
    },
    "verifier_evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    }
  },
  "required": [
    "id",
    "live_receipt_digest",
    "run_id",
    "nonce",
    "change_set_digest",
    "preview_digest",
    "orchestration_plan_digest",
    "decisions",
    "admitted_candidate_digests",
    "rejected_candidate_digests",
    "target_writes",
    "source_evidence_class",
    "verifier_evidence_class",
    "claim_boundary"
  ],
  "title": "AgentCandidateIngestionReceipt",
  "type": "object"
}
