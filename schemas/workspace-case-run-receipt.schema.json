{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "https://orgrebase.local/schemas/workspace-case-run-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "case_ref": {
      "title": "Case Ref",
      "type": "string"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "evidence_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceClass"
        },
        {
          "enum": [
            "DESIGN",
            "LIVE_MODEL",
            "USER_STUDY"
          ],
          "type": "string"
        }
      ],
      "title": "Evidence Class"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "output_digest": {
      "title": "Output Digest",
      "type": "string"
    },
    "public_output": {
      "$ref": "#/$defs/JsonValue"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ABSTAIN",
        "ERROR",
        "NOT_RUN"
      ],
      "title": "Status",
      "type": "string"
    },
    "system_profile": {
      "title": "System Profile",
      "type": "string"
    }
  },
  "required": [
    "id",
    "case_ref",
    "system_profile",
    "mode",
    "status",
    "public_output",
    "output_digest",
    "artifact_refs",
    "evidence_class",
    "run_id",
    "completed_at"
  ],
  "title": "CaseRunReceipt",
  "type": "object"
}
