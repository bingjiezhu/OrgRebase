{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-domain-candidate-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "candidate_refs": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Refs",
      "type": "array"
    },
    "candidate_set_digest": {
      "title": "Candidate Set Digest",
      "type": "string"
    },
    "coalition_plan_ref": {
      "title": "Coalition Plan Ref",
      "type": "string"
    },
    "delegation_task_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delegation Task Ref"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "domain_id": {
      "title": "Domain Id",
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "task_ref": {
      "title": "Task Ref",
      "type": "string"
    },
    "template_ref": {
      "title": "Template Ref",
      "type": "string"
    },
    "transport_mode": {
      "enum": [
        "LOCAL_DETERMINISTIC",
        "LIVE_AGENTTEAMS"
      ],
      "title": "Transport Mode",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task_ref",
    "template_ref",
    "coalition_plan_ref",
    "domain_id",
    "worker_id",
    "candidate_refs",
    "candidate_set_digest",
    "transport_mode",
    "evidence_class"
  ],
  "title": "DomainCandidateBundle",
  "type": "object"
}
