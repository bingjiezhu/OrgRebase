{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-domain-transport-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_bundle_digest": {
      "title": "Candidate Bundle Digest",
      "type": "string"
    },
    "candidate_bundle_ref": {
      "title": "Candidate Bundle Ref",
      "type": "string"
    },
    "delegation_task_ref": {
      "title": "Delegation Task Ref",
      "type": "string"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "domain_id": {
      "title": "Domain Id",
      "type": "string"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "room_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Room Id"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "delegation_task_ref",
    "worker_id",
    "domain_id",
    "candidate_bundle_ref",
    "candidate_bundle_digest",
    "evidence_class"
  ],
  "title": "DomainTransportCandidate",
  "type": "object"
}
