{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "LIVE_AGENTTEAMS",
        "LOCAL_REAL_TOOL",
        "LOCAL_DETERMINISTIC",
        "SYNTHETIC_FIXTURE",
        "PASS_STATIC",
        "NOT_RUN"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "EvidenceIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "claim_supported": {
          "title": "Claim Supported",
          "type": "string"
        },
        "contains_sensitive_data": {
          "title": "Contains Sensitive Data",
          "type": "boolean"
        },
        "digest": {
          "default": "",
          "title": "Digest",
          "type": "string"
        },
        "evidence_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceClass"
            },
            {
              "enum": [
                "DESIGN",
                "LIVE_MODEL",
                "USER_STUDY"
              ],
              "type": "string"
            }
          ],
          "title": "Evidence Class"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "negative_test_ids": {
          "items": {
            "type": "string"
          },
          "title": "Negative Test Ids",
          "type": "array"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "verifier_command": {
          "title": "Verifier Command",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "media_type",
        "sha256",
        "evidence_class",
        "claim_supported",
        "verifier_command",
        "negative_test_ids",
        "contains_sensitive_data"
      ],
      "title": "EvidenceIndexEntry",
      "type": "object"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-evidence-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/EvidenceIndexEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "event_chain_head": {
      "title": "Event Chain Head",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "entries",
    "event_chain_head",
    "status",
    "generated_at"
  ],
  "title": "EvidenceIndex",
  "type": "object"
}
