{
  "$id": "https://orgrebase.local/schemas/workspace-quote-payload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_manifest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Manifest"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "data_residency": {
      "title": "Data Residency",
      "type": "string"
    },
    "deliverable_kind": {
      "const": "QUOTE",
      "default": "QUOTE",
      "title": "Deliverable Kind",
      "type": "string"
    },
    "launch_date": {
      "title": "Launch Date",
      "type": "string"
    },
    "notice_required": {
      "title": "Notice Required",
      "type": "boolean"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "partner_terms_code": {
      "title": "Partner Terms Code",
      "type": "string"
    },
    "price_band": {
      "title": "Price Band",
      "type": "string"
    },
    "product_plan": {
      "title": "Product Plan",
      "type": "string"
    },
    "rebase_change_set": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rebase Change Set"
    },
    "rebased_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rebased From"
    }
  },
  "required": [
    "owner",
    "customer_id",
    "product_plan",
    "launch_date",
    "data_residency",
    "notice_required",
    "price_band",
    "currency",
    "partner_terms_code"
  ],
  "title": "QuotePayload",
  "type": "object"
}
