{
  "$defs": {
    "ClaimScope": {
      "enum": [
        "ORGANIZATION",
        "TASK"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "DependencyStrength": {
      "enum": [
        "HARD",
        "REVIEW",
        "INFORMATIONAL"
      ],
      "title": "DependencyStrength",
      "type": "string"
    },
    "SemanticKind": {
      "enum": [
        "CLAIM",
        "POLICY",
        "SKILL",
        "TOOL",
        "LITERAL"
      ],
      "title": "SemanticKind",
      "type": "string"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-requirement-slot-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_purposes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Purposes",
      "type": "array"
    },
    "allowed_recipients": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Recipients",
      "type": "array"
    },
    "claim_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "domain_id": {
      "title": "Domain Id",
      "type": "string"
    },
    "freshness_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Seconds"
    },
    "output_field_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Output Field Paths",
      "type": "array"
    },
    "relation": {
      "title": "Relation",
      "type": "string"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "semantic_kind": {
      "$ref": "#/$defs/SemanticKind"
    },
    "sensitivity_ceiling": {
      "default": "INTERNAL",
      "title": "Sensitivity Ceiling",
      "type": "string"
    },
    "slot_id": {
      "title": "Slot Id",
      "type": "string"
    },
    "strength": {
      "$ref": "#/$defs/DependencyStrength"
    },
    "value_schema_ref": {
      "title": "Value Schema Ref",
      "type": "string"
    }
  },
  "required": [
    "slot_id",
    "semantic_kind",
    "domain_id",
    "value_schema_ref",
    "required",
    "relation",
    "strength",
    "allowed_purposes",
    "allowed_recipients"
  ],
  "title": "RequirementSlotSpec",
  "type": "object"
}
