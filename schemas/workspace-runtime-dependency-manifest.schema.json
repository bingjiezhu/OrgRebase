{
  "$defs": {
    "DependencyStrength": {
      "enum": [
        "HARD",
        "REVIEW",
        "INFORMATIONAL"
      ],
      "title": "DependencyStrength",
      "type": "string"
    },
    "ManifestCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "ManifestCompleteness",
      "type": "string"
    },
    "RuntimeDependencyEntry": {
      "additionalProperties": false,
      "properties": {
        "consumer_ref": {
          "title": "Consumer Ref",
          "type": "string"
        },
        "provider_digest": {
          "title": "Provider Digest",
          "type": "string"
        },
        "provider_ref": {
          "title": "Provider Ref",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "source_event_digest": {
          "title": "Source Event Digest",
          "type": "string"
        },
        "source_event_ref": {
          "title": "Source Event Ref",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/DependencyStrength"
        },
        "valid_from": {
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "consumer_ref",
        "provider_ref",
        "provider_digest",
        "relation",
        "strength",
        "source_event_ref",
        "source_event_digest",
        "slot_id",
        "valid_from"
      ],
      "title": "RuntimeDependencyEntry",
      "type": "object"
    }
  },
  "$id": "https://orgrebase.local/schemas/workspace-runtime-dependency-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_domain": {
      "title": "Authority Domain",
      "type": "string"
    },
    "compiled_at": {
      "title": "Compiled At",
      "type": "string"
    },
    "compiler_version": {
      "title": "Compiler Version",
      "type": "string"
    },
    "completeness": {
      "$ref": "#/$defs/ManifestCompleteness"
    },
    "consumer_ref": {
      "title": "Consumer Ref",
      "type": "string"
    },
    "coverage_receipt_ref": {
      "title": "Coverage Receipt Ref",
      "type": "string"
    },
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/RuntimeDependencyEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "issuer_id": {
      "title": "Issuer Id",
      "type": "string"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "revision_lock": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Revision Lock",
      "type": "object"
    },
    "task_ref": {
      "title": "Task Ref",
      "type": "string"
    },
    "trace_ref": {
      "title": "Trace Ref",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "consumer_ref",
    "task_ref",
    "trace_ref",
    "coverage_receipt_ref",
    "issuer_id",
    "authority_domain",
    "completeness",
    "entries",
    "provenance_refs",
    "revision_lock",
    "compiled_at",
    "compiler_version"
  ],
  "title": "RuntimeDependencyManifest",
  "type": "object"
}
