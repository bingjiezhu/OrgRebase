    "ObjectState": {
      "enum": [
        "PROPOSED",
        "CURRENT",
        "SUPERSEDED",
        "STALE",
        "REVIEW_REQUIRED",
        "REBASE_REQUIRED",
        "ROLLED_BACK_PENDING_REBASE",
        "REQUALIFICATION_REQUIRED",
